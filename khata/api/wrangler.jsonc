{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kadan-kanakku-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khata",
      // Replace with the id printed by: npx wrangler d1 create khata --location=apac
      "database_id": "17708293-d548-4bd8-ad9c-b76596867a66",
      "migrations_dir": "migrations"
    }
  ],
  // The web app (built by `cd ../app && npx vite build --mode web`) is served as Workers static assets: free and
  // unlimited, no Worker invocation. Only /v1/* runs the Worker. Security headers for the HTML/JS come from the
  // `_headers` file that scripts/prepare-assets.mjs copies into the directory (see web/_headers).
  "assets": {
    "directory": "../app/dist-web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"]
  },
  // Runs before `wrangler dev` and `wrangler deploy`: writes dist-web/_headers (and a placeholder index.html when
  // the web app has not been built yet). Never builds or deletes the web app itself.
  "build": { "command": "node scripts/prepare-assets.mjs" },
  // Per-client-IP first layers (Workers Rate Limiting; per location, best effort).
  // namespace_id is any positive integer unique within the account.
  "ratelimits": [
    { "name": "PAIR_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // /auth/prelogin, /auth/login and /auth/google (each counted under its own key).
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    // Per device per UTC day. Fast sync polls every 20 s while a phone is in use (once a minute when idle): a counter
    // phone left open day and night makes about 4,000 at most; the cap stops one broken phone eating the 100k/day.
    "DAILY_REQUEST_CAP": "10000",
    "PAIR_THROTTLE_AFTER": "20",
    // Wrong password logins per UTC day (whole shop) before the 1-per-30-s throttle.
    "AUTH_THROTTLE_AFTER": "100",
    // Google sign-in on the web: comma-separated WEB OAuth client ids (the FIRST is shown to the browser).
    // Empty = Google sign-in off on the web (/v1/auth/google answers 404, /v1/config returns google_client_id: null).
    "GOOGLE_CLIENT_IDS": "",
    // Google sign-in from the Android app (Credential Manager): the shop's Android/server OAuth client ids.
    // Empty = Android Google logins are refused with 404 (web client ids are never accepted for client 'android').
    "GOOGLE_ANDROID_CLIENT_IDS": "",
    // Optional Google Workspace domain whose addresses may be pre-registered besides @gmail.com / @googlemail.com.
    "GOOGLE_HD": ""
  }
  // Secrets (never in this file):
  //   npx wrangler secret put PEPPER      (required)
  //   npx wrangler secret put SETUP_KEY   (optional; /v1/setup answers 404 without it)
}
