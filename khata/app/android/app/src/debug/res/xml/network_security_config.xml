<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY. Allows http:// so a developer can point the app at wrangler dev with ip 0.0.0.0
     on a LAN address (e.g. http://192.168.1.20:8787). Release builds use src/main/res/xml/network_security_config.xml
     which forbids cleartext. User CAs are trusted here so a debugging proxy can be used. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
