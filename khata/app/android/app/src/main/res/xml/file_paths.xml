<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider roots. Only the cache sub-folder the app writes shared files to (platform/native.ts SHARE_DIR)
     is exposed; Capacitor's default also exposed all of external storage, which this app never uses. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="share" path="share/" />
</paths>
