<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system CAs only (no user-installed CAs). The debug build overrides this file
     (src/debug/res/xml/network_security_config.xml) to allow cleartext for `wrangler dev` on a LAN IP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
