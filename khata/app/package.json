{
  "name": "kadan-kanakku-app",
  "private": true,
  "version": "2.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "build:android": "node scripts/check-speech-patch.mjs && tsc --noEmit -p . && vite build --mode android && cap sync android",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "postinstall": "patch-package --error-on-fail",
    "check:speech-patch": "node scripts/check-speech-patch.mjs",
    "patch:speech": "patch-package @capgo/capacitor-speech-recognition --include 'android/src/|dist/esm/definitions\\.d\\.ts'"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-speech-recognition": "8.3.2",
    "libphonenumber-js": "^1.13.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/sql.js": "^1.4.11",
    "patch-package": "^8.0.1",
    "playwright": "1.56.1",
    "sql.js": "^1.14.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
